# Cloud MySQL connection (recommended for Vercel production)
# DATABASE_URL=mysql://user:password@host:3306/pawsitive?ssl={"rejectUnauthorized":true}

# Or individual MySQL variables (used locally)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=pawsitive

# Strong random secret for JWT signing in production
JWT_SECRET=replace-with-a-strong-random-secret
